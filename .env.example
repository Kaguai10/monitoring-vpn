# Required: create a private .env from this template before running ./run.sh
ADMIN_USERNAME=administrator
ADMIN_PASSWORD=replace-with-a-strong-password

# Public IPv4 address or DNS name clients use to reach WireGuard
WG_PUBLIC_IP=203.0.113.10
WG_PORT=51820
WG_INTERFACE=wg0

# VPN address plan. Example: server 10.66.66.1/24, client range .101-.115
VPN_NETWORK=10.66.66.0/24
VPN_SERVER_IP=10.66.66.1
VPN_CLIENT_RANGE_START=10.66.66.101
VPN_CLIENT_RANGE_END=10.66.66.115
CLIENT_NAME_PREFIX=client
CLIENT_EMAIL_DOMAIN=example.invalid
VPN_DNS_UPSTREAM=1.1.1.1
CLIENT_ALLOWED_IPS="0.0.0.0/0, ::/0"
VPN_EGRESS_INTERFACE=

# Public web monitor HTTP port
PORT=3000
DB_PATH=
TZ=Etc/UTC
NODE_ENV=production

# Generated automatically by run.sh when left empty
SESSION_SECRET=
RESET_KEY=

# Monitor
POLL_INTERVAL=5000
DNS_POLL_INTERVAL=2000
DISCONNECT_TIMEOUT=120
DATA_RETENTION_HOURS=168
DEMO_MODE=false

# Host paths; normally leave unchanged
WG_CONFIG_PATH=/etc/wireguard/wg0.conf
DNSMASQ_LOG_PATH=/var/log/dnsmasq.log
