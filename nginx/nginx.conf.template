# ============================================================
# Nginx reverse proxy config untuk VPN Monitor
# Static files + API proxy + security headers + rate limiting
# ============================================================

server {
    listen 80;
    listen 443 ssl;
    ssl_certificate /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    server_name _;

    # --- Security Headers ---
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Permitted-Cross-Domain-Policies "none" always;

    # --- Static Files (CSS, JS) - served directly by nginx ---
    # Lebih efisien daripada Node.js untuk static files
    location /css/ {
        root /usr/share/nginx/html/public;
        expires 1d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    location /js/ {
        root /usr/share/nginx/html/public;
        expires 1d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # --- Health check (no rate limit) ---
    location /health {
        proxy_pass http://127.0.0.1:${APP_PORT};
        proxy_set_header Host $host;
        access_log off;
    }

    # --- Login endpoint (rate limited untuk anti brute force) ---
    location /login {
        limit_req zone=login burst=10 nodelay;
        proxy_pass http://127.0.0.1:${APP_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /reset-password {
        limit_req zone=login burst=5 nodelay;
        proxy_pass http://127.0.0.1:${APP_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # --- API endpoints (rate limited) ---
    location /api/ {
        limit_req zone=api burst=20 nodelay;
        proxy_pass http://127.0.0.1:${APP_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeout untuk API yang mungkin lambat (query database)
        proxy_read_timeout 30s;
        proxy_connect_timeout 5s;
    }

    # --- Change password / logout ---
    location /change-password {
        limit_req zone=login burst=5 nodelay;
        proxy_pass http://127.0.0.1:${APP_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /logout {
        proxy_pass http://127.0.0.1:${APP_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # --- Everything else (page rendering) ---
    location / {
        proxy_pass http://127.0.0.1:${APP_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Untuk SSE / WebSocket (future use)
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400s;

        # Cache HTML pages briefly
        proxy_cache_bypass $http_upgrade;
    }

    # --- Error pages ---
    error_page 502 503 504 /50x.html;
    location = /50x.html {
        default_type text/html;
        return 502 '<!DOCTYPE html><html><head><meta charset="utf-8"><title>VPN Monitor Offline</title><style>body{background:#0a0e14;color:#e6edf3;font-family:sans-serif;display:flex;align-items:center;justify-content:center;height:100vh;margin:0}.box{text-align:center;padding:40px;border:1px solid #2a3441;border-radius:12px;max-width:400px}h1{color:#f85149}p{color:#8b949e}</style></head><body><div class="box"><h1>502 - Server Offline</h1><p>VPN Monitor sedang tidak tersedia. Tunggu sebentar atau hubungi admin.</p></div></body></html>';
    }
}
