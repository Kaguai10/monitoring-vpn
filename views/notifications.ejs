<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('partials/head', { title: 'Notifikasi' }) %>
</head>
<body>
  <%- include('partials/nav', { admin, demoMode, page }) %>

  <main class="main-content">
    <header class="page-header">
      <button class="mobile-menu-btn" onclick="toggleSidebar()">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <div>
        <h1>Notifikasi</h1>
        <p class="page-subtitle">User yang putus, akses DNS diblokir, dan akses AI</p>
      </div>
      <div class="header-right">
        <button class="btn-secondary" onclick="markAllRead()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
          Tandai Semua Dibaca
        </button>
        <span class="last-update" id="lastUpdate">-</span>
      </div>
    </header>

    <!-- Filter tabs -->
    <div class="filter-bar">
      <div class="filter-tabs">
        <button class="filter-tab active" data-filter="all">Semua</button>
        <button class="filter-tab" data-filter="disconnect">
          <span class="filter-dot dot-orange"></span>
          VPN Putus
        </button>
        <button class="filter-tab" data-filter="blocked_dns">
          <span class="filter-dot dot-red"></span>
          DNS Diblokir
        </button>
        <button class="filter-tab" data-filter="ai_access">
          <span class="filter-dot dot-blue"></span>
          Akses AI
        </button>
      </div>
    </div>

    <!-- Notifications list -->
    <div class="notif-list" id="notifList">
      <div class="loading-spinner">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="spin"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
        <p>Memuat notifikasi...</p>
      </div>
    </div>

    <div id="noNotifs" class="empty-state" style="display:none;">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
      <p>Tidak ada notifikasi</p>
    </div>
  </main>

  <%- include('partials/footer', { jsFile: 'notifications' }) %>
