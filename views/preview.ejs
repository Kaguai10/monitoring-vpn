<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('partials/head', { title: 'User Detail' }) %>
</head>
<body>
  <%- include('partials/nav', { admin, demoMode, page }) %>

  <main class="main-content">
    <header class="page-header">
      <button class="mobile-menu-btn" onclick="toggleSidebar()">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <div>
        <a href="/users" class="back-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
          Kembali ke Users
        </a>
        <h1 id="previewTitle">User Detail</h1>
      </div>
      <div class="header-right">
        <span class="last-update" id="lastUpdate">-</span>
      </div>
    </header>

    <!-- User Info Card -->
    <div class="card user-profile-card" id="profileCard">
      <div class="user-profile-avatar" id="profileAvatar">?</div>
      <div class="user-profile-info">
        <h2 id="profileName">Loading...</h2>
        <p class="user-profile-email" id="profileEmail">-</p>
        <div class="user-profile-badges">
          <span class="badge badge-ip" id="profileIp"><%= peerIp %></span>
          <span class="badge badge-status" id="profileStatus">-</span>
          <span class="badge badge-strength" id="profileStrength">-</span>
        </div>
      </div>
      <div class="user-profile-meta">
        <div class="profile-meta-item">
          <span class="meta-label">Endpoint</span>
          <span class="meta-value" id="profileEndpoint">-</span>
        </div>
        <div class="profile-meta-item">
          <span class="meta-label">Last Handshake</span>
          <span class="meta-value" id="profileHandshake">-</span>
        </div>
        <div class="profile-meta-item">
          <span class="meta-label">Terdaftar Sejak</span>
          <span class="meta-value" id="profileFirstSeen">-</span>
        </div>
      </div>
    </div>

    <!-- Stats Cards -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-icon stat-icon-blue">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
        </div>
        <div class="stat-info">
          <span class="stat-label">Total DNS Request</span>
          <span class="stat-value" id="statDnsTotal">-</span>
          <span class="stat-sub" id="statDnsTotalSub">query</span>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-icon stat-icon-green">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        </div>
        <div class="stat-info">
          <span class="stat-label">Connection Success</span>
          <span class="stat-value" id="statConnSuccess">-</span>
          <span class="stat-sub" id="statConnSuccessSub">uptime</span>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-icon stat-icon-purple">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
        </div>
        <div class="stat-info">
          <span class="stat-label">Trafik Download</span>
          <span class="stat-value" id="statRx">-</span>
          <span class="stat-sub" id="statTxLabel">Upload: -</span>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-icon stat-icon-red">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </div>
        <div class="stat-info">
          <span class="stat-label">DNS Diblokir</span>
          <span class="stat-value" id="statDnsBlocked">-</span>
          <span class="stat-sub" id="statDnsAiLabel">AI: -</span>
        </div>
      </div>
    </div>

    <!-- Charts -->
    <div class="chart-grid">
      <div class="card chart-card-wide">
        <div class="card-header">
          <h3>Trafik DNS User (1 Jam Terakhir)</h3>
        </div>
        <div class="chart-container">
          <canvas id="userDnsChart"></canvas>
        </div>
      </div>

      <div class="card chart-card-wide">
        <div class="card-header">
          <h3>Trafik Bandwidth User</h3>
        </div>
        <div class="chart-container">
          <canvas id="userBandwidthChart"></canvas>
        </div>
      </div>
    </div>

    <!-- DNS Lists -->
    <div class="dns-sections">
      <!-- All DNS visited -->
      <div class="card dns-list-card">
        <div class="card-header">
          <h3>DNS yang Dikunjungi</h3>
          <div class="dns-filter-tabs">
            <button class="dns-filter-tab active" data-type="all">Semua</button>
            <button class="dns-filter-tab" data-type="blocked">Diblokir</button>
            <button class="dns-filter-tab" data-type="ai">AI</button>
            <button class="dns-filter-tab" data-type="normal">Normal</button>
          </div>
        </div>
        <div class="dns-list" id="dnsListAll">
          <div class="loading-spinner small">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="spin"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
          </div>
        </div>
      </div>

      <!-- Blocked DNS -->
      <div class="card dns-list-card">
        <div class="card-header">
          <h3>Upaya Akses DNS Diblokir</h3>
          <span class="card-badge badge-red" id="blockedCount">0</span>
        </div>
        <div class="dns-list" id="dnsListBlocked">
          <div class="loading-spinner small">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="spin"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
          </div>
        </div>
      </div>

      <!-- AI Access -->
      <div class="card dns-list-card">
        <div class="card-header">
          <h3>Akses Layanan AI</h3>
          <span class="card-badge badge-blue" id="aiCount">0</span>
        </div>
        <div class="dns-list" id="dnsListAi">
          <div class="loading-spinner small">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="spin"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
          </div>
        </div>
      </div>
    </div>

    <!-- Connection History -->
    <div class="card">
      <div class="card-header">
        <h3>Riwayat Koneksi</h3>
      </div>
      <div class="conn-history" id="connHistory">
        <div class="loading-spinner small">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="spin"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
        </div>
      </div>
    </div>

    <input type="hidden" id="peerIp" value="<%= peerIp %>">
  </main>

  <%- include('partials/footer', { jsFile: 'preview' }) %>
