<aside class="sidebar" id="sidebar">
  <div class="sidebar-header">
    <div class="logo">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 2L2 7l10 5 10-5-10-5z"/>
        <path d="M2 17l10 5 10-5"/>
        <path d="M2 12l10 5 10-5"/>
      </svg>
      <div class="logo-text">
        <span class="logo-title">VPN Monitor</span>
        <span class="logo-sub">Versi 1.0 Edition</span>
      </div>
    </div>
  </div>

  <nav class="nav-menu">
    <a href="/dashboard" class="nav-item <%= page === 'dashboard' ? 'active' : '' %>">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="3" width="7" height="7" rx="1"/>
        <rect x="14" y="3" width="7" height="7" rx="1"/>
        <rect x="3" y="14" width="7" height="7" rx="1"/>
        <rect x="14" y="14" width="7" height="7" rx="1"/>
      </svg>
      <span>Dashboard</span>
    </a>

    <div class="nav-group <%= page.startsWith('users') ? 'expanded' : '' %>">
    <div class="nav-item nav-parent <%= page.startsWith('users') ? 'active' : '' %>">
      <a href="/users" class="nav-main-link">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
        <circle cx="9" cy="7" r="4"/>
        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
      </svg>
      <span>Users</span>
      </a>
      <button class="nav-expand" type="button" aria-label="Buka submenu Users" aria-expanded="<%= page.startsWith('users') ? 'true' : 'false' %>" onclick="toggleUsersSubmenu(this)">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </div>
    <div class="nav-submenu">
      <a class="<%= page === 'users' ? 'active' : '' %>" href="/users">Daftar user</a>
      <a class="<%= page === 'users-register' ? 'active' : '' %>" href="/users/register">Registrasi user</a>
      <a class="<%= page === 'users-export' ? 'active' : '' %>" href="/users/export">Ekspor VPN config</a>
      <a class="<%= page === 'users-manage' ? 'active' : '' %>" href="/users/manage">Manage user</a>
    </div>
    </div>

    <a href="/notifications" class="nav-item <%= page === 'notifications' ? 'active' : '' %>" id="nav-notif">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
        <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
      </svg>
      <span>Notifikasi</span>
      <span class="nav-badge" id="nav-notif-badge" style="display:none;">0</span>
    </a>

    <a href="/settings" class="nav-item <%= page === 'settings' ? 'active' : '' %>">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="3"/>
        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
      </svg>
      <span>Settings</span>
    </a>
  </nav>

  <div class="sidebar-footer">
    <div class="admin-info">
      <div class="admin-avatar">
        <%= admin.username.charAt(0).toUpperCase() %>
      </div>
      <div class="admin-details">
        <span class="admin-name"><%= admin.username %></span>
        <a href="#" onclick="logout(); return false;" class="admin-logout">Logout</a>
      </div>
    </div>
    <% if (demoMode) { %>
    <div class="demo-badge">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      <span>DEMO MODE</span>
    </div>
    <% } %>
  </div>
</aside>

<div class="mobile-overlay" id="mobileOverlay" onclick="toggleSidebar()"></div>

<!-- Toast Notification Container -->
<div class="toast-container" id="toastContainer"></div>

<div class="modal-overlay action-confirm-overlay" id="actionConfirmModal" style="display:none" role="dialog" aria-modal="true" aria-labelledby="actionConfirmTitle">
  <div class="modal-box">
    <div class="modal-header"><h2 id="actionConfirmTitle">Konfirmasi tindakan</h2><button class="modal-close" id="actionConfirmClose" type="button" aria-label="Tutup">&times;</button></div>
    <div class="modal-body">
      <p class="modal-desc" id="actionConfirmMessage"></p>
      <ul class="action-confirm-details" id="actionConfirmDetails" hidden></ul>
      <div class="modal-actions"><button class="btn-secondary" id="actionConfirmCancel" type="button">Batal</button><button class="btn-danger" id="actionConfirmAccept" type="button">Lanjutkan</button></div>
    </div>
  </div>
</div>
