<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('partials/head', { title: 'Users' }) %>
</head>
<body>
  <%- include('partials/nav', { admin, demoMode, page }) %>

  <main class="main-content">
    <header class="page-header">
      <button class="mobile-menu-btn" onclick="toggleSidebar()">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <div>
        <h1>User VPN</h1>
        <p class="page-subtitle">Daftar user yang terhubung ke VPN</p>
      </div>
      <div class="header-right">
        <span class="last-update" id="lastUpdate">-</span>
      </div>
    </header>

    <!-- Users count summary -->
    <div class="users-summary" id="usersSummary" style="display:none;">
      <div class="summary-badge summary-total">
        <span class="summary-dot-lg"></span>
        <span class="summary-count" id="totalCount">0</span>
        <span class="summary-label">Total User</span>
      </div>
      <div class="summary-badge summary-online">
        <span class="summary-dot-lg"></span>
        <span class="summary-count" id="onlineCount">0</span>
        <span class="summary-label">Online</span>
      </div>
      <div class="summary-badge summary-offline">
        <span class="summary-dot-lg"></span>
        <span class="summary-count" id="offlineCount">0</span>
        <span class="summary-label">Offline</span>
      </div>
    </div>

    <!-- Filter bar -->
    <div class="filter-bar">
      <div class="search-box">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" id="searchInput" placeholder="Cari nama, email, atau IP...">
      </div>
      <div class="filter-tabs">
        <button class="filter-tab active" data-filter="all">Semua</button>
        <button class="filter-tab" data-filter="connected">Online</button>
        <button class="filter-tab" data-filter="disconnected">Offline</button>
      </div>
    </div>

    <!-- User cards grid -->
    <div class="user-cards-grid" id="userCardsGrid">
      <div class="loading-spinner">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="spin"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
        <p>Memuat data user...</p>
      </div>
    </div>

    <div id="noUsers" class="empty-state" style="display:none;">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/></svg>
      <p>Tidak ada user ditemukan</p>
    </div>
  </main>

  <%- include('partials/footer', { jsFile: 'users' }) %>
